%titulos  $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$
\newcommand{\@encabezadoCientificoPre}{%
	{%
		\setlength{\fboxsep}{5pt}%
		\noindent\makebox[\textwidth][l]{%
			\fcolorbox{ColorEncabezado}{ColorEncabezado}{%
				\fontsize{13}{15}\selectfont\sffamily\bfseries\textcolor{ColorClaro}{%
					\ifx\dTipoCapitulo\empty ART\'ICULO\else\MakeUppercase{\dTipoCapitulo}\fi~N.\textsuperscript{o}~\thechapter%
				}%
			}%
			\ifx\dMateria\empty\else
				\hspace{3mm}\fontsize{13}{15}\selectfont\sffamily\bfseries\textcolor{ColorOscuro}{\MakeUppercase{\dMateria}}%
			\fi
			\hfill
			\ifx\dFecha\empty\else
				\fontsize{13}{15}\selectfont\sffamily\mdseries\textcolor{ColorOscuro}{\dFecha}%
			\fi
		}%
	}%
}

\newcommand{\@encabezadoCientificoPost}{%
	\par\vspace{2mm}%
	\ifx\dDescripcion\empty\else
		\noindent{\fontsize{15}{20}\selectfont\sffamily\itshape\color{ColorOscuro}\raggedright\dDescripcion\par}%
	\fi
	\vspace{3mm}%
	\noindent\textcolor{ColorOscuro}{\rule{\textwidth}{1.5pt}}\par
	\vspace{3.5mm}%
	\noindent{\fontsize{18}{23}\selectfont\rmfamily\bfseries\color{ColorOscuro}\raggedright
		\ifx\dAutores\empty\dAutoresCorto\else\dAutores\fi\par}%
	\ifx\dVinculacionDocente\empty\else
		\vspace{1mm}%
		\noindent{\fontsize{14}{19}\selectfont\rmfamily\itshape\color{ColorNegro}\raggedright\dVinculacionDocente\par}%
	\fi
	\ifx\dInstitucion\empty\else
		\vspace{1.5mm}%
		\noindent{\fontsize{14}{19}\selectfont\rmfamily\mdseries\color{ColorNegro}\raggedright
			\dInstitucion\ifx\dCiudad\empty\else\ --- \dCiudad\fi\par}%
	\fi
	\ifx\dCorreo\empty\else
		\vspace{1mm}%
		\noindent{\fontsize{13}{18}\selectfont\ttfamily\color{ColorOscuro}\raggedright
			\href{mailto:\dCorreo}{\dCorreo}\par}%
	\fi
	\ifx\dResumen\empty\else
		\vspace{5mm}%
		{%
			\setlength{\fboxsep}{10pt}%
			\setlength{\fboxrule}{0.9pt}%
			\noindent\fcolorbox{ColorEncabezado}{ColorContenido}{%
				\parbox[t]{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}{%
					\fontsize{14}{19}\selectfont\rmfamily\mdseries\color{ColorNegro}%
					\textbf{\textcolor{ColorOscuro}{Resumen---}}\dResumen\par
					\ifx\dPalabrasClave\empty\else
						\vspace{2.5mm}%
						\noindent\textcolor{ColorOscuro}{\rule{\linewidth}{0.4pt}}\par
						\vspace{1.5mm}%
						\noindent\raggedright\textbf{\textcolor{ColorOscuro}{Palabras clave: }}\emph{\dPalabrasClave}\par
					\fi
				}%
			}%
		}%
		\par
	\fi
}

