\newcommand{\@datoAutor}[2]{%
	\par\noindent\hangindent=4.6cm\hangafter=1%
	\makebox[4.6cm][l]{\textbf{\textcolor{ColorOscuro}{#1}}}#2\par
}

\newcommand{\InformacionAutor}
{%
	\par\vspace{8mm}\noindent
	\begin{minipage}[t]{\columnwidth}%
		\setlength{\fboxsep}{10pt}%
		\setlength{\fboxrule}{1.2pt}%
		\noindent\fcolorbox{ColorEncabezado}{ColorEncabezado}{%
			\parbox[t]{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
				\fontsize{17}{21}\selectfont
				\textcolor{ColorClaro}{\textbf{Informaci\'on del Autor y Referencia del Art\'iculo}}%
				\ifx\dTipoCapitulo\empty\else
					\hfill\textcolor{ColorClaro}{\textsc{\dTipoCapitulo~\thechapter}}%
				\fi
			}%
		}%
		\par\nointerlineskip\noindent
		\fcolorbox{ColorEncabezado}{ColorContenido}{%
			\parbox[t]{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
				\raggedright
				{\color{ColorNegro}%
					{\fontsize{19}{24}\selectfont\textbf{\textcolor{ColorOscuro}{%
						\ifx\dAutores\empty\dAutoresCorto\else\dAutores\fi%
					}}\par}%
					\ifx\dVinculacionDocente\empty\else
						\vspace{1.5mm}%
						{\fontsize{15}{20}\selectfont\emph{\dVinculacionDocente}\par}%
					\fi
					\vspace{3mm}%
					\textcolor{ColorOscuro}{\rule{\linewidth}{0.8pt}}\par
					\vspace{3mm}%
					{\fontsize{15}{21}\selectfont
						\ifx\dInstitucion\empty\else\@datoAutor{Instituci\'on:}{\dInstitucion}\fi
						\ifx\dGrupo\empty\else\@datoAutor{Grupo:}{\dGrupo}\fi
						\ifx\dMateria\empty\else\@datoAutor{\'Area / Materia:}{\dMateria}\fi
						\ifx\dCiudad\empty
							\ifx\dFecha\empty\else\@datoAutor{Fecha:}{\dFecha}\fi
						\else
							\ifx\dFecha\empty
								\@datoAutor{Ubicaci\'on:}{\dCiudad}%
							\else
								\@datoAutor{Lugar y fecha:}{\dCiudad\ --- \dFecha}%
							\fi
						\fi
						\ifx\dCorreo\empty\else
							\@datoAutor{Correo:}{\href{mailto:\dCorreo}{\texttt{\dCorreo}}}%
						\fi
					}%
					\vspace{4mm}%
					{%
						\setlength{\fboxsep}{8pt}%
						\setlength{\fboxrule}{0.8pt}%
						\noindent\fcolorbox{ColorOscuro}{ColorClaro}{%
							\parbox[t]{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
								\raggedright
								{\fontsize{15}{20}\selectfont\textbf{\textcolor{ColorOscuro}{C\'omo referenciar este art\'iculo}}\par}%
								\vspace{2.5mm}%
								{\fontsize{14}{19}\selectfont
									\par\noindent\hangindent=1.8cm\hangafter=1%
									\makebox[1.8cm][l]{\textbf{APA:}}%
									\ifx\dAutores\empty\dAutoresCorto\else\dAutores\fi\ %
									(\dFecha). %
									\emph{\ifx\dNombreCapitulo\empty\dTitulo\else\dNombreCapitulo\fi}. %
									\ifx\dTipoCapitulo\empty\else\dTipoCapitulo~\thechapter, \fi%
									\ifx\dMateria\empty\else\dMateria. \fi%
									\dInstitucion\ifx\dCiudad\empty\else, \dCiudad\fi.\par
									\vspace{2mm}%
									\par\noindent\hangindent=1.8cm\hangafter=1%
									\makebox[1.8cm][l]{\textbf{IEEE:}}%
									[1] \ifx\dAutoresCorto\empty\dAutores\else\dAutoresCorto\fi, %
									``\ifx\dNombreCapitulo\empty\dTitulo\else\dNombreCapitulo\fi,'' %
									\emph{\ifx\dMateria\empty\dInstitucion\else\dMateria\ -- \dInstitucion\fi}, %
									\ifx\dTipoCapitulo\empty\else\dTipoCapitulo~\thechapter, \fi%
									\ifx\dCiudad\empty\else\dCiudad, \fi\dFecha.\par
								}%
							}%
						}%
					}%
				}%
			}%
		}%
	\end{minipage}%
	\par\vspace{5mm}%
}

