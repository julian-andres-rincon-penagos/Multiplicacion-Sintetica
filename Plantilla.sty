\newcommand{\@EntradaReferencia}[1]{%
	\stepcounter{Bibliograf}%
	\par\vspace{2.5mm}%
	{\raggedright\noindent
	\hangindent=1.4cm\hangafter=1%
	\makebox[1.4cm][l]{\textbf{\textcolor{ColorOscuro}{[\theBibliograf]}}}%
	#1\par}%
}

\newcommand{\ReferenciaLibro}[5]{%
	\@EntradaReferencia{%
		#1 (#2). \emph{#3}. %
		\if\relax\detokenize{#4}\relax#5.\else#4: #5.\fi
	}%
}

\newcommand{\ReferenciaRevista}[6]{%
	\@EntradaReferencia{%
		#1 (#2). #3. \emph{#4}%
		\if\relax\detokenize{#5}\relax\else, \emph{#5}\fi
		\if\relax\detokenize{#6}\relax\else, #6\fi.%
	}%
}

\newcommand{\ReferenciaInternet}[4]{%
	\@EntradaReferencia{%
		#1 (#2). \emph{#3}. Recuperado de \url{#4}%
	}%
}

